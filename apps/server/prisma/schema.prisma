generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Anonymous side
// ---------------------------------------------------------------------------

enum AnonymousUserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

model AnonymousUser {
  id                String              @id @default(cuid())
  publicId          String              @unique
  /// Optional name chosen by the visitor. Unlike Conversation.adminAlias,
  /// this belongs to the anonymous identity and is visible to both sides.
  displayName       String?
  signingPublicKey  Bytes
  exchangePublicKey Bytes
  status            AnonymousUserStatus @default(ACTIVE)
  /// Only populated when STORE_IP_ADDRESSES=true. Used purely for abuse
  /// mitigation (e.g. blocking a device creating many identities).
  registrationIp    String?
  createdAt         DateTime            @default(now())
  lastSeenAt        DateTime            @default(now())

  /// Optional, opt-in only: offered once after this identity's first sent
  /// message, purely so it can be emailed when the admin replies. Never
  /// required, never used for anything else. See docs/SECURITY.md.
  notificationEmail       String?
  notificationEmailSentAt DateTime?

  conversation      Conversation?
  sessions          AnonymousSession[]
  pushSubscriptions PushSubscription[]
  visitorInsight    VisitorInsight?

  @@map("anonymous_users")
}

model AnonymousSession {
  id              String        @id @default(cuid())
  anonymousUserId String
  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  ipAddress       String?
  createdAt       DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  revokedAt       DateTime?

  @@index([anonymousUserId])
  @@map("anonymous_sessions")
}

// ---------------------------------------------------------------------------
// Conversation / messages
//
// Message/attachment/reaction content columns hold ciphertext only - this
// server can never read them. See docs/SECURITY.md.
// ---------------------------------------------------------------------------

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum SenderType {
  USER
  ADMIN
}

model Conversation {
  id              String             @id @default(cuid())
  anonymousUserId String             @unique
  anonymousUser   AnonymousUser      @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)
  status          ConversationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lastMessageAt   DateTime?
  deletedAt       DateTime?
  /// Admin-only nickname for this contact. Never sent to the anonymous user.
  adminAlias      String?
  /// Admin-only mute state: when set, new messages from this conversation
  /// don't fire admin notifications. Never sent to the anonymous user.
  mutedAt         DateTime?

  messages   Message[]
  note       ConversationNote?
  noteAssets NoteAsset[]

  @@index([status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType

  contentCiphertext Bytes?
  contentNonce      Bytes?

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  edited    Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime?

  attachments Attachment[]
  reactions   MessageReaction[]

  @@index([conversationId, createdAt])
  /// Supports the admin digest's "how many USER messages arrived since the
  /// last digest, system-wide" sweep (notificationDigest.service.ts) -
  /// distinct from the composite index above, which is scoped per-conversation.
  @@index([senderType, createdAt])
  @@map("messages")
}

model Attachment {
  id         String  @id @default(cuid())
  messageId  String
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey String  @unique

  /// Encrypted envelope carrying filename/mimetype/size - opaque to the server.
  metaCiphertext Bytes
  metaNonce      Bytes

  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("attachments")
}

model MessageReaction {
  id         String     @id @default(cuid())
  messageId  String
  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  senderType SenderType

  emojiCiphertext Bytes
  emojiNonce      Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, senderType])
  @@map("message_reactions")
}

/// One shared, end-to-end encrypted rich note per conversation. The server
/// can coordinate updates but cannot read the TipTap JSON document.
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  contentCiphertext Bytes
  contentNonce      Bytes
  updatedBy         SenderType
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("conversation_notes")
}

/// Encrypted binary media embedded in the shared note. Filename and MIME
/// type live only inside metaCiphertext; bytes in storage are ciphertext.
model NoteAsset {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  storageKey     String       @unique
  metaCiphertext Bytes
  metaNonce      Bytes
  sizeBytes      Int
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("note_assets")
}

// ---------------------------------------------------------------------------
// Admin (site owner) side
// ---------------------------------------------------------------------------

model Admin {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  displayName  String
  avatarUrl    String?

  totpEnabled          Boolean @default(false)
  /// AES/XChaCha-encrypted at rest with a key derived from SESSION_SECRET.
  totpSecretCiphertext Bytes?
  totpSecretNonce      Bytes?

  signingPublicKey  Bytes
  exchangePublicKey Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          AdminSession[]
  cannedReplies     CannedReply[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]

  @@map("admins")
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([adminId])
  @@map("admin_sessions")
}

model SiteSettings {
  /// Singleton row - always id = 1.
  id                Int     @id @default(1)
  siteTitle         String  @default("Anonchat")
  displayName       String  @default("Site Owner")
  bio               String  @default("")
  /// Public markdown shown before a visitor sends the first encrypted
  /// message. It is intentionally not stored as a Message: an automatic
  /// server-authored message could not be signed/encrypted as the admin
  /// without putting the admin's private key on the server.
  welcomeMessage    String  @default("Welcome! Send a message below to start an anonymous, end-to-end encrypted conversation.")
  avatarUrl         String?
  /// Public gallery displayed in the visitor-facing admin profile panel.
  profilePhotosJson Json    @default("[]")
  contactLinksJson  Json    @default("[]")
  pgpPublicKey      String?
  /// Public operator-authored notice covering controller identity, purposes,
  /// recipients, retention, rights, and contact details.
  privacyPolicyUrl  String?
  presenceEnabled   Boolean @default(true)
  /// Theme identifier, e.g. "monochrome-dark", "paper", "forest-dark".
  theme             String  @default("monochrome-dark")

  /// Where the admin's new-message digest email is sent. Email
  /// notifications are entirely inert without both this AND EMAIL_DRIVER
  /// configured server-side (see apps/server/src/email/).
  adminNotificationEmail          String?
  adminEmailDigestEnabled         Boolean   @default(false)
  /// Admin-configurable, but never allowed below
  /// ADMIN_DIGEST_MIN_INTERVAL_MINUTES (an operator-level floor) - see
  /// notificationDigest.service.ts.
  adminEmailDigestIntervalMinutes Int       @default(15)
  lastAdminDigestSentAt           DateTime?

  /// Server-side kill switch for admin push, independent of the browser
  /// permission grant itself - push is also entirely inert without VAPID_*
  /// configured server-side (see apps/server/src/push/).
  adminPushEnabled Boolean @default(true)

  /// Optional visitor diagnostics are OFF by default. Enabling this only
  /// allows the consent prompt to be shown; no row is written until that
  /// visitor explicitly opts in. Disabling it deletes existing rows.
  visitorInsightsEnabled       Boolean @default(false)
  visitorInsightsRetentionDays Int     @default(30)

  /// Runtime product controls. These belong to the operator dashboard, not
  /// deployment environment variables. Per-type attachment limits are
  /// enforced before encryption by the client; the global limit is also
  /// enforced by the server's multipart parser.
  maxMessageLength                  Int     @default(100000)
  maxAttachmentSizeMb               Int     @default(100)
  maxImageAttachmentSizeMb          Int     @default(20)
  maxVideoAttachmentSizeMb          Int     @default(100)
  maxAudioAttachmentSizeMb          Int     @default(30)
  maxDocumentAttachmentSizeMb       Int     @default(50)
  maxOtherAttachmentSizeMb          Int     @default(25)
  maxAttachmentsPerMessage          Int     @default(5)
  messageEditWindowMinutes          Int     @default(15)
  rateLimitMessagesPerMinute        Int     @default(20)
  rateLimitRegistrationsPerHour     Int     @default(10)
  rateLimitLinkPreviewsPerMinute    Int     @default(20)
  linkPreviewsEnabled               Boolean @default(true)
  storeIpAddresses                  Boolean @default(false)
  visitorGeolocationEnabled         Boolean @default(false)
  adminDigestMinIntervalMinutes     Int     @default(5)
  replyEmailMinIntervalMinutes      Int     @default(2)

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// Consented, time-limited visitor diagnostics. Values reported by the
/// browser are descriptive, not an authentication/fingerprinting signal.
/// No canvas/font fingerprint, exact GPS coordinate, cookies, history, or
/// message content is collected here.
model VisitorInsight {
  id              String        @id @default(cuid())
  anonymousUserId String        @unique
  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)

  consentVersion String   @default("2026-08-14")
  consentedAt    DateTime @default(now())
  expiresAt      DateTime

  ipAddress      String?
  userAgent      String?
  browserName    String?
  browserVersion String?
  osName         String?
  osVersion      String?
  deviceType     String?
  platform       String?

  language  String?
  languages Json    @default("[]")
  timezone  String?

  screenWidth         Int?
  screenHeight        Int?
  viewportWidth       Int?
  viewportHeight      Int?
  pixelRatio          Float?
  colorDepth          Int?
  touchPoints         Int?
  hardwareConcurrency Int?
  deviceMemoryGb      Float?

  connectionType          String?
  connectionEffectiveType String?
  connectionDownlinkMbps  Float?
  connectionRttMs         Int?
  connectionSaveData      Boolean?
  referrerOrigin          String?

  geoCountryCode String?
  geoCountry     String?
  geoRegion      String?
  geoCity        String?
  geoPostalCode  String?
  geoLatitude    Float?
  geoLongitude   Float?
  geoTimezone    String?
  networkAsn     Int?
  networkOrg     String?
  networkIsp     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("visitor_insights")
}

model CannedReply {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@map("canned_replies")
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String?
  admin        Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action       String
  targetType   String?
  targetId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

/// A browser's Web Push registration. adminId and anonymousUserId may both
/// be set: PushManager exposes one subscription per origin, so a browser
/// used for both roles must share the endpoint without one role silently
/// disabling the other. At least one owner is maintained by the routes.
model PushSubscription {
  id              String         @id @default(cuid())
  adminId         String?
  admin           Admin?         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  anonymousUserId String?
  anonymousUser   AnonymousUser? @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)
  endpoint        String         @unique
  p256dh          String
  auth            String
  createdAt       DateTime       @default(now())

  @@index([adminId])
  @@index([anonymousUserId])
  @@map("push_subscriptions")
}
