# ============================================================================
# Anonchat configuration
#
# Only the "REQUIRED" section below must be set for a working deployment.
# Everything else is optional and has a safe, privacy-preserving default.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# If you're using docker-compose.yml (recommended), it starts its own
# Postgres container and only needs a password here - it builds the full
# connection string for you from POSTGRES_USER/POSTGRES_DB (both already
# defaulted below) plus this password.
POSTGRES_PASSWORD=

# Running the server directly (no Docker Compose)? Set this instead - a
# full PostgreSQL connection string to any reachable Postgres instance.
# Ignored by docker-compose.yml, which builds its own from the vars above.
DATABASE_URL=postgresql://anonchat:anonchat@localhost:5432/anonchat

# Random secret used to sign session cookies and CSRF tokens.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# The public URL this instance is served on (used for cookie scoping,
# absolute links, and CORS). Include the scheme.
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OPTIONAL - server
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# Set to true if this app is served behind a reverse proxy (nginx, Caddy,
# a PaaS load balancer) so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# OPTIONAL - privacy / abuse handling
# ---------------------------------------------------------------------------

# Whether to store submitter IP addresses on anonymous accounts and messages
# (used only for abuse mitigation, e.g. blocking a device that keeps creating
# new identities). Never shown to anonymous users; visible to the admin only
# if enabled. Off by default to minimize data collection.
STORE_IP_ADDRESSES=false

MAX_MESSAGE_LENGTH=100000
MAX_ATTACHMENT_SIZE_MB=25
MAX_ATTACHMENTS_PER_MESSAGE=5
MESSAGE_EDIT_WINDOW_MINUTES=15

RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_REGISTRATIONS_PER_HOUR=10
RATE_LIMIT_LINK_PREVIEWS_PER_MINUTE=20

# Rich previews (Open Graph title/description/image) for links shared in
# chat mean the server fetches that URL's metadata on the caller's behalf -
# SSRF-guarded (see docs/ARCHITECTURE.md's "Link previews" section for the
# full trade-off), but a deliberate, narrow exception to this app's general
# rule that the server never learns what's inside a conversation. YouTube/
# Vimeo embeds are unaffected either way - those are pure client-side URL
# pattern matching with no server involvement. Set to false if you'd rather
# the server never originate outbound requests based on message content.
LINK_PREVIEWS_ENABLED=true

# Reserved for a future Cloudflare Turnstile CAPTCHA on identity creation -
# not implemented yet (the server never verifies a token against these
# keys), so setting them currently has no effect. Identity-creation abuse
# mitigation today is RATE_LIMIT_REGISTRATIONS_PER_HOUR above. Leave blank.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL - email notifications
#
# Entirely off (EMAIL_DRIVER=none) by default. Powers two independent,
# opt-in features: the admin's periodic new-message digest (configured in
# the dashboard's Settings page) and a visitor's one-time "email me when
# they reply" prompt. Message content is end-to-end encrypted, so neither
# email can ever include it - only counts/links. See docs/ARCHITECTURE.md.
# ---------------------------------------------------------------------------

# "none" (default), "smtp", or "resend".
EMAIL_DRIVER=none
# Required for either driver - the From address these emails are sent as.
EMAIL_FROM=

# Only used when EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Only used when EMAIL_DRIVER=resend - https://resend.com
RESEND_API_KEY=

# Operator-level safety floors - the per-admin digest interval (set in
# Settings) and the per-visitor reply-email cadence can never go below
# these, regardless of what's configured in the UI.
ADMIN_DIGEST_MIN_INTERVAL_MINUTES=5
REPLY_EMAIL_MIN_INTERVAL_MINUTES=2

# ---------------------------------------------------------------------------
# OPTIONAL - Web Push notifications
#
# Generate one long-lived keypair with:
#   pnpm --filter @anonchat/server run push:generate-vapid-keys
# Keep the private key secret. VAPID_SUBJECT is a mailto: or HTTPS contact
# push services can use for abuse reports. All three values are required
# together; leaving all three blank disables Web Push.
# ---------------------------------------------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# OPTIONAL - file storage
# ---------------------------------------------------------------------------

# "local" (default, no extra setup - files live on disk under UPLOAD_DIR) or
# "s3" (works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, or any
# S3-compatible endpoint).
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads

# Only used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for MinIO and most non-AWS endpoints:
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# OPTIONAL - docker-compose Postgres container settings
# (only used by docker-compose.yml; ignored if you set DATABASE_URL yourself)
# ---------------------------------------------------------------------------

POSTGRES_USER=anonchat
POSTGRES_DB=anonchat

# ---------------------------------------------------------------------------
# OPTIONAL - self-hosted MinIO (S3-compatible storage), via:
#   docker compose --profile minio up -d
# then set STORAGE_DRIVER=s3, S3_ENDPOINT=http://minio:9000, S3_BUCKET=anonchat,
# and S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY matching these credentials.
# ---------------------------------------------------------------------------

MINIO_ROOT_USER=anonchat
MINIO_ROOT_PASSWORD=
