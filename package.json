{
  "name": "anonchat",
  "private": true,
  "version": "0.0.1",
  "description": "Self-hosted anonymous persistent messaging inbox",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "dev:server": "pnpm --filter @anonchat/server run dev",
    "dev:web": "pnpm --filter @anonchat/web run dev",
    "build": "pnpm --filter @anonchat/crypto run build && pnpm --filter @anonchat/shared run build && pnpm --filter @anonchat/server run build && pnpm --filter @anonchat/web run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @anonchat/server run db:migrate",
    "db:generate": "pnpm --filter @anonchat/server run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@9.15.1"
}
